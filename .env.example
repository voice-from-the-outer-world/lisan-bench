# Copy this file to `.env` and fill in only the providers you actually use.
# Leave unused variables blank or omit them entirely.

# Core routing
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Direct provider adapters
MOONSHOT_API_KEY=
ZAI_API_KEY=
ZENMUX_API_KEY=

# Optional provider-specific API base overrides
# MOONSHOT_API_BASE=https://api.moonshot.ai/v1
# ZAI_API_BASE=https://api.z.ai/api/paas/v4
# ZENMUX_API_BASE=https://api.zenmux.ai/v1

# Runner settings
MAX_TOKENS=100000
TEMPERATURE=1.0
# BENCH_HEARTBEAT_SECONDS=300

# Optional Z.ai behavior
# ZAI_TOKENIZER_FALLBACK=1

# Optional ZenMux behavior
# ZENMUX_INCLUDE_REASONING_TEXT=0
